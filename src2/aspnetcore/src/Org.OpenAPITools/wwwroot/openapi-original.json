            "type" : "string"
          },
          "value" : {
            "example" : "true",
            "type" : "string"
          }
        },
        "required" : [ "key", "value" ],
        "type" : "object"
      },
      "GetConfigurationsResponse" : {
        "example" : {
          "entries" : [ {
            "value" : "value",
            "key" : "key"
          }, {
            "value" : "value",
